# Copy this file to .env and fill in real values. NEVER commit the real .env.

# --- OpenRouter (LLM) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-sonnet-5
# Optional override:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Google Sheets (prototype DB) ---
# LOCAL DEV: path to the service-account JSON (kept in the gitignored credentials/ dir)
GOOGLE_APPLICATION_CREDENTIALS=credentials/ai-dietician-prototype-e83a44308285.json
# PRODUCTION (Vercel): instead of the file above, paste the ENTIRE service-account
# JSON as one value in the GOOGLE_CREDENTIALS_JSON env var. Do NOT set it in this
# local file; set it only in Vercel's Environment Variables.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account", ...}
# Spreadsheet ID (the part of the Sheet URL between /d/ and /edit)
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# --- Web / voice demo ---
# 5050 avoids macOS AirPlay Receiver (which uses 5000)
WEB_PORT=5050
DEFAULT_USER_ID=U001

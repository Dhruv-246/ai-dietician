# Copy to .env and fill in. Do NOT commit .env.

# --- LLM: Groq (Llama 70B "versatile") ---
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# --- Speech-to-text: Deepgram (Hinglish) ---
SARVAM_API_KEY=your_sarvam_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key
STT_MODEL=saarika:v2.5
# "multi" = Hindi + English code-mixing (Hinglish). Use "hi" for mostly-Hindi.
STT_LANGUAGE=multi

# --- Text-to-speech: Cartesia (Hindi) ---
CARTESIA_API_KEY=your_cartesia_api_key
# Multilingual model so Hindi (Devanagari) is pronounced correctly.
CARTESIA_MODEL=sonic-3.5
# IMPORTANT: pick a Hindi / multilingual voice from the Cartesia dashboard and put its
# id here. The default below is an English voice and will sound off for Hindi.
CARTESIA_VOICE_ID=your_hindi_or_multilingual_cartesia_voice_id

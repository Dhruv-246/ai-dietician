# Copy to .env and fill in. Do NOT commit .env.

# --- LLM provider ---
# bedrock | groq. Left unset it picks bedrock when AWS credentials are present
# and groq otherwise, so a broken AWS setup falls back instead of taking calls
# down.
# LLM_PROVIDER=bedrock

# --- AWS Bedrock (preferred: Claude Haiku for Hinglish + instruction-following) ---
# ONE variable sets the model for everything. Copy the exact id from the
# Bedrock console — Claude ids usually carry a REGION PREFIX, e.g.
#   apac.anthropic.claude-haiku-4-5-v1:0   (Asia)
#   us.anthropic.claude-haiku-4-5-v1:0     (US)
# Using the wrong prefix for your region fails with a validation error.
BEDROCK_MODEL=apac.anthropic.claude-haiku-4-5-v1:0
# AUTH -- pick ONE of the two shapes.
# (a) Bedrock API key. This is a single BEARER TOKEN, not an access key. If the
#     console handed you one long opaque string, this is what you have.
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key
# (b) The classic IAM pair. Leave blank if you used (a).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Pick the region CLOSEST TO YOUR USERS — a US endpoint adds a round trip to
# every single turn, which is exactly the latency we are trying to remove.
AWS_REGION=ap-south-1
# Optional, only if your credentials are temporary (STS).
# AWS_SESSION_TOKEN=
# Optional per-job overrides. Only set these if one model is not right for all
# three jobs — start with BEDROCK_MODEL alone.
# BEDROCK_CHAT_MODEL=            # conversation
# BEDROCK_FAST_MODEL=            # P-3 router, P-2 node check
# BEDROCK_CONSOLIDATION_MODEL=   # post-call memory patch

# --- LLM: Groq (fallback) ---
# Groq is not just the no-AWS default. It is also the live fallback: if a
# Bedrock call fails mid-conversation, that turn is retried on Groq rather than
# dropped, so keep GROQ_API_KEY set even when running on Bedrock.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
# gpt-oss is a REASONING model — it spends completion tokens thinking before
# writing. At max_tokens=120 it burned 118 on reasoning and returned an EMPTY
# reply. Cap generously and buy brevity with reasoning_effort instead; the
# prompt and the per-stage word budgets control actual length.
LLM_MAX_TOKENS=400
LLM_REASONING_EFFORT=low
# Post-call memory consolidation. NOT the 20b — it fails the strict patch
# schema with json_validate_failed and an empty generation. Runs once after
# hangup, so latency is irrelevant and correctness is everything.
GROQ_CONSOLIDATION_MODEL=openai/gpt-oss-120b

# --- Speech-to-text: Deepgram (Hinglish) ---
SARVAM_API_KEY=your_sarvam_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key
STT_MODEL=saarika:v2.5
# "multi" = Hindi + English code-mixing (Hinglish). Use "hi" for mostly-Hindi.
STT_LANGUAGE=multi
# Keyterm boosting. OFF by default. Flux sends these in the WebSocket query
# string, and the full 140-term list made the URL long enough that Deepgram
# rejected the connection with HTTP 400 — STT never connected and nothing the
# user said was transcribed. Enable with a SHORT list and raise it gradually,
# checking STT still connects each time. Hard-capped by DEEPGRAM_KEYTERM_LIMIT.
# DEEPGRAM_KEYTERMS=PCOS,PCOD,thyroid,diabetes,cholesterol,anaemia
# DEEPGRAM_KEYTERM_LIMIT=20
# Make Deepgram itself withhold transcripts it doesn't believe. Unset by
# default — dropping real speech is worse than a bad transcript.
# DEEPGRAM_MIN_CONFIDENCE=0.4
# Second line of defence, applied in-process by TranscriptGate. 0 = off.
# STT_MIN_CONFIDENCE=0.5
# Turn detection. eot_timeout_ms is how long Flux waits AFTER the user stops
# speaking when it is not confident the turn ended. Deepgram's default is
# 5000ms — five seconds of dead air before a transcript even exists, which the
# user experiences as Mira being slow. We default to 2000. Raise it if people
# get cut off mid-sentence; lower it for snappier turns at that risk.
# eot_threshold is left at Deepgram's default on purpose: it governs the
# CONFIDENT case, which already fires immediately, and lowering it starts
# cutting people off.
# DEEPGRAM_EOT_TIMEOUT_MS=2000
# DEEPGRAM_EOT_THRESHOLD=0.7
# Let Flux predict end-of-turn EARLY so generation starts sooner. Costs a
# retry when the prediction is wrong. Try 0.7 if turns still feel slow.
# DEEPGRAM_EAGER_EOT=0.7

# --- Text-to-speech: which engine? ---
# cartesia (default) | gemini | sarvam | elevenlabs | auto
TTS_ENGINE=cartesia

# --- TTS option 1: Cartesia (paid) — ~0.3s to first audio ---
CARTESIA_API_KEY=your_cartesia_api_key
# Multilingual model so Hindi (Devanagari) is pronounced correctly.
CARTESIA_MODEL=sonic-3.5
# IMPORTANT: pick a Hindi / multilingual voice from the Cartesia dashboard and put its
# id here. The default below is an English voice and will sound off for Hindi.
CARTESIA_VOICE_ID=your_hindi_or_multilingual_cartesia_voice_id

# --- TTS option 2: Gemini (free) — measured 5-7s to first audio, dev use only ---
# Set TTS_ENGINE=gemini to use these. Keep the key separate from GOOGLE_API_KEY so
# burning TTS quota doesn't also take down the RAG embeddings.
GEMINI_TTS_API_KEY=your_gemini_tts_api_key
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
# Gemini's genai backend IGNORES the `language` setting — it only ever sends voice_name.
# This style prefix is therefore the ONLY way to steer it toward Hinglish. Leave it
# empty and Gemini will read Hindi words in an English accent.
GEMINI_TTS_STYLE=Speak in a warm, natural Hinglish - conversational Indian English mixed with Hindi, like a friendly dietician talking to a friend.
